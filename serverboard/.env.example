# LATCH Serverboard (Backend API) Environment Variables
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_your_key
SUPABASE_KEY=sb_secret_your_key
SUPABASE_SERVICE_ROLE=your_service_role_secret_key

# Inngest Background Worker
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Render Service Integration (Optional in local dev)
RENDER_API_KEY=your_render_api_key
RENDER_WEBHOOK_SECRET=your_render_webhook_secret

# Networking & Ports
PORT=4000
FRONTEND_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
