# LATCH Root Environment Variables
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_your_key
SUPABASE_KEY=sb_secret_your_key
SUPABASE_SERVICE_ROLE=your_service_role_secret_key

# Inngest Background Worker
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Serverboard API Port & URLs
PORT=4000
FRONTEND_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# PayPal API Configuration (Sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
PAYPAL_BYPASS_WEBHOOK_VERIFICATION=false
