{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Desktop for AI agents — coordination, locks, and Mission Control.",
  "workspaces": [
    "mission-control"
  ],
  "bin": {
    "latch": "cli/latch.js",
    "relay": "cli/latch.js"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"node backend/server.js --port 3001\" \"npm run dev -w mission-control\"",
    "dev:api": "node backend/server.js --port 3001",
    "dev:ui": "npm run dev -w mission-control",
    "start": "node backend/server.js --port 3001",
    "coordinator": "node backend/coordinator/server.js",
    "check:db": "node backend/supabase/check-connection.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:backend": "node --test \"tests/backend/**/*.test.js\"",
    "test:mission-control": "node --test \"tests/mission-control/**/*.test.js\"",
    "test:landing": "node --test \"tests/landing/**/*.test.js\"",
    "test:unit": "node --test \"tests/**/unit/*.test.js\"",
    "test:e2e": "node --test \"tests/**/e2e/*.test.js\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
