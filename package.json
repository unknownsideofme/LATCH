{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Desktop for AI agents â€” coordination, locks, and Mission Control.",
  "workspaces": [
    "mission-control"
  ],
  "bin": {
    "latch": "cli/latch.js",
    "relay": "cli/latch.js"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"node backend/server.js --port 3001\" \"npm run dev -w mission-control\"",
    "dev:api": "node backend/server.js --port 3001",
    "dev:ui": "npm run dev -w mission-control",
    "start": "node backend/server.js --port 3001",
    "coordinator": "node backend/coordinator/server.js",
    "check:db": "node backend/supabase/check-connection.js",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend",
    "test:mission-control": "vitest run tests/mission-control",
    "test:landing": "vitest run tests/landing",
    "test:unit": "vitest run tests/**/unit",
    "test:e2e": "vitest run tests/**/e2e",
    "test:coverage": "vitest run --coverage",
    "test:node": "node tests/run.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
